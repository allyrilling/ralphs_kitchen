{{- $sections := slice "dinner-party" "out-on-the-town" -}}
{{- $pages := where .Site.RegularPages "Section" "in" $sections -}}
[
  {{- range $i, $p := $pages -}}
  {{- if $i -}},{{- end -}}
  {
    "title":   {{ $p.Title | jsonify }},
    "url":     {{ $p.RelPermalink | jsonify }},
    "image":   {{ (default "" $p.Params.image) | jsonify }},
    "summary": {{ with $p.Params.description }}{{ . | htmlUnescape | jsonify }}{{ else }}{{ $p.Summary | plainify | htmlUnescape | jsonify }}{{ end }}
  }
  {{- end -}}
]
